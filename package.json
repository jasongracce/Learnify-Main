{
  "name": "learnify",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "test": "pnpm --filter web test:api && pnpm --filter @learnify/core test && pnpm --filter @learnify/ai test && pnpm --filter @learnify/database test",
    "test:ai": "pnpm --filter @learnify/ai test",
    "test:rag": "pnpm --filter @learnify/database test:rag"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
